# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Force CRLF for Windows specific batch and powershell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must always use LF
*.sh text eol=lf

# Markdown and JSON
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
